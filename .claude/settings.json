{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python -m pytest*)",
      "Bash(python -m pytest*)",
      "Bash(pytest*)",
      "Bash(jarvis-memory query *)",
      "Bash(jarvis-memory eval*)",
      "Bash(jarvis-memory fact-history *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch)",
      "Bash(git switch -c *)",
      "Bash(git checkout -b *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(jarvis-memory ingest *)",
      "Bash(jarvis-memory add-fact *)",
      "Edit(pyproject.toml)",
      "Edit(data/**)",
      "Edit(.claude/**)"
    ],
    "deny": [
      "Edit(.jarvis_memory/**)",
      "Edit(.venv/**)",
      "Edit(**/__pycache__/**)",
      "Edit(*.egg-info/**)",
      "Read(.env)",
      "Read(.env.*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 10,
            "statusMessage": "Guardrail-Check"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_tests.sh\"",
            "timeout": 180,
            "statusMessage": "pytest (Guardrail)"
          }
        ]
      }
    ]
  }
}
